# Copy to .env and fill in values
# OpenObserve connection
OPENOBSERVE_URL=http://localhost:5200
OPENOBSERVE_USER=admin@velaris.local
OPENOBSERVE_PASS=Admin1234!
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=velaris_logs

# SQLite results database
DB_PATH=db/incidents.db

# Dashboard API (uvicorn)
PORT=8501
